<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /admin/

    # Serve existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else to React
    RewriteRule ^ index.html [L]
</IfModule>
